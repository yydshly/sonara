# Copy to .env inside sonara, fill in locally, then restart the server.
# Never put the key in dist or browser storage.
ELEVENLABS_API_KEY=
SONARA_MUSIC_MODEL=music_v2_5
SONARA_PORT=4173

# Personal music studio: reuse the locally signed-in Codex and MiniMax Code.
# Executable paths only, never a shell command. Leave blank to auto-detect .local/minimax-code, then use PATH.
# SONARA_CODEX_BIN=C:/path/to/codex.exe
# SONARA_MCODE_BIN=C:/path/to/mcode.exe
# For an npm MiniMax Code installation, use node.exe plus its CLI entry script:
# SONARA_MCODE_BIN=C:/path/to/node.exe
# SONARA_MCODE_ENTRY=C:/path/to/@minimax-ai/code/cli.js
# Optional per-run model reference, as reported by your own MiniMax Code:
# SONARA_MCODE_MODEL=provider/model
