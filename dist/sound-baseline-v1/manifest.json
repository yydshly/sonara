{
  "id": "sound-baseline-v1",
  "title": "靠窗那边",
  "bpm": 108,
  "key": "F 大调",
  "duration": 23.42222222222222,
  "brief": "多年后的重逢，从靠窗的习惯认出老朋友；轻快、亲近，结尾温暖，不强加悲伤。",
  "lyrics": [
    "你又坐在靠窗那边",
    "笑着问我这些年",
    "我说日子忙了点",
    "你笑起来，还像从前"
  ],
  "phrases": [
    {
      "start": 1.9444444444444444,
      "end": 6.666666666666667,
      "text": "你又坐在靠窗那边",
      "intent": "轻轻认出熟悉的习惯；靠窗连贯，边字顺着旋律落下。"
    },
    {
      "start": 6.944444444444445,
      "end": 11.11111111111111,
      "text": "笑着问我这些年",
      "intent": "像面对面问候；这些年连成一句，年字留下回想的空间。"
    },
    {
      "start": 11.38888888888889,
      "end": 15.555555555555555,
      "text": "我说日子忙了点",
      "intent": "回答时稍收回去；忙字停留，了字经过，点字不夸张。"
    },
    {
      "start": 15.833333333333334,
      "end": 21.666666666666668,
      "text": "你笑起来，还像从前",
      "intent": "笑起来展开到全段最高点；停半拍，再把从前轻轻落稳。"
    }
  ],
